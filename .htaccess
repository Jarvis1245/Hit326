# Route all requests through public/index.php
# Works on Apache with mod_rewrite enabled (standard on cPanel/shared hosting).

Options -Indexes
RewriteEngine On

# Allow direct access to existing public/ files (CSS, images, uploads)
RewriteCond %{REQUEST_URI} ^/public/
RewriteRule ^ - [L]

# Route everything else to the front controller
RewriteRule ^(.*)$ public/index.php [QSA,L]
